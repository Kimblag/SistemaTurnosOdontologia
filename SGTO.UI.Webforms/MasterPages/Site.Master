<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="SGTO.UI.Webforms.MasterPages.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Gestión de Turnos </title>

    <%--fuentes de Google--%>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900&display=swap" rel="stylesheet">


    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:BundleReference runat="server" Path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <%--Paleta de colores del sistema y estilos propios--%>
    <link href="~/Content/TemaApp.css" rel="stylesheet" />
    <link href="~/Content/Pages/Dashboard.css" rel="stylesheet" />

    <%--iconos de bootstrap--%>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body class="app-theme">
    <form runat="server" maintainscrollpositiononpostback="true">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <%--contenedor principal de la app--%>
        <div id="app-shell">

            <%-- menu izquierda --%>
            <aside class="sidebar">

                <%--logo--%>
                <div class="sidebar-header d-flex align-items-center gap-3 p-4 border-bottom">
                    <div class="logo-icon text-theme-primary d-flex align-items-center justify-content-center">
                        <svg fill="none" class="logo-svg" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                            <path d="M42.4379 44C42.4379 44 36.0744 33.9038 41.1692 24C46.8624 12.9336 42.2078 4 42.2078 4L7.01134 4C7.01134 4 11.6577 12.932 5.96912 23.9969C0.876273 33.9029 7.27094 44 7.27094 44L42.4379 44Z" fill="currentColor"></path>
                        </svg>
                    </div>
                    <h2 id="NombreClinica" runat="server" class="sidebar-title fw-bold">SGTO</h2>
                </div>

                <%--opciones de menu--%>
                <nav class="sidebar-menu d-flex flex-column flex-fill p-4 gap-2">
                    <a id="MenuDashboard" runat="server" href="~/Pages/Home/Dashboard.aspx" class="menu-item">
                        <i class="bi bi-house-door-fill fs-5"></i><span>Inicio</span>
                    </a>
                    <a id="MenuTurnos" runat="server" href="~/Pages/Turnos/Index.aspx" class="menu-item">
                        <i class="bi bi-calendar-check fs-5"></i><span>Turnos</span>
                    </a>
                    <a id="MenuPacientes" runat="server" href="~/Pages/Pacientes/Index.aspx" class="menu-item">
                        <i class="bi bi-person-vcard fs-5"></i><span>Pacientes</span>
                    </a>
                    <a id="MenuMedicos" runat="server" href="~/Pages/Medicos/Index.aspx" class="menu-item">
                        <i class="bi bi-person-badge fs-5"></i><span>Médicos</span>
                    </a>
                    <a id="MenuCoberturas" runat="server" href="~/Pages/CoberturasPlanes/Index.aspx" class="menu-item">
                        <i class="bi bi-shield-check fs-5"></i><span>Coberturas</span>
                    </a>
                    <a id="MenuEspecialidades" runat="server" href="~/Pages/Especialidades/Index.aspx" class="menu-item">
                        <i class="bi bi-layers fs-5"></i><span>Especialidades</span>
                    </a>
                    <a id="MenuTratamientos" runat="server" href="~/Pages/Tratamientos/Index.aspx" class="menu-item">
                        <i class="bi bi-heart-pulse fs-5"></i><span>Tratamientos</span>
                    </a>
                    <a id="MenuReportes" runat="server" href="~/Pages/Reportes/Index.aspx" class="menu-item">
                        <i class="bi bi-bar-chart-line fs-5"></i><span>Reportes</span>
                    </a>
                    <a id="MenuConfiguracion" runat="server" href="~/Pages/Configuracion/Index.aspx" class="menu-item">
                        <i class="bi bi-gear fs-5"></i><span>Configuración</span>
                    </a>
                </nav>

                <%--cerrar sesion--%>
                <div class="p-4 mt-auto">
                    <asp:LinkButton ID="btnCerrarSesion" runat="server" CssClass="btn-logout w-100 text-decoration-none d-flex align-items-center justify-content-center gap-2" OnClick="btnCerrarSesion_Click" CausesValidation="false">
                        <i class="bi bi-box-arrow-right fs-5"></i>
                        <span>Cerrar sesión</span>
                    </asp:LinkButton>
                </div>

            </aside>


            <%--contenido principal--%>
            <section class="layout-main">

                <header class="layout-header border-bottom bg-white py-3 mb-4">
                    <div class="container-fluid d-flex align-items-center justify-content-between">

                        <div class="d-flex align-items-center gap-3">

                            <asp:HyperLink ID="btnVolver" runat="server"
                                Visible="false"
                                CssClass="btn btn-light border shadow-sm d-flex align-items-center justify-content-center rounded-circle"
                                Style="width: 38px; height: 38px; padding: 0;">
                                <i class="bi bi-arrow-left text-secondary"></i>
                            </asp:HyperLink>

                            <div class="d-flex flex-column">
                                <h1 id="TituloSeccion" runat="server" class="h4 fw-bold mb-0 text-dark">Inicio
                                </h1>
                                <p id="SubtituloSeccion" runat="server" class="mb-0 text-muted small">
                                </p>
                            </div>
                        </div>

                        <a class="text-end border-start ps-3 d-flex align-items-center gap-2 text-decoration-none user-profile-link"
                            href='<%= ResolveUrl("~/Pages/Perfil/Index.aspx") %>'>

                            <div class="d-flex flex-column align-items-end">
                                <p id="NombreUsuario" runat="server" class="fw-bold mb-0 text-dark fs-6 font-monospace text-truncate" style="max-width: 150px;">
                                    Usuario
       
                                </p>
                                <p id="RolUsuario" runat="server" class="text-muted mb-0 small text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                    Rol
       
                                </p>
                            </div>

                            <div class="position-relative">
                                <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center text-primary" style="width: 40px; height: 40px;">
                                    <i class="bi bi-person-fill fs-5"></i>
                                </div>
                                <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-light rounded-circle">
                                    <span class="visually-hidden">Activo</span>
                                </span>
                            </div>
                        </a>

                    </div>
                </header>

                <%--paginas--%>
                <div class="layout-content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </div>

                <%--footer--%>
                <footer class="layout-footer text-muted small">
                    <p class="mb-0">&copy; <%: DateTime.Now.Year %> - SGTO</p>
                </footer>
            </section>

        </div>

    </form>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
</body>
</html>
